{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    // "preserve" rather than "react-jsx": Claude Code's mod API resolves JSX
    // components at runtime via `$.ui.resolve(e)`. There is no React runtime
    // in a mod, so pointing at react/jsx-runtime would be a lie that hides real
    // type errors. The mod's own tsconfig overrides this per-package.
    "jsx": "preserve",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["the-codes/**/*.ts", "the-codes/**/*.tsx"],
  // Host-testkit tests import `claude-code/testing`, whose types ship inside
  // Claude Code rather than npm. `claude plugin test` supplies them; a bare
  // `tsc` cannot, so excluding the dir keeps `typecheck` meaningful instead of
  // permanently red for a reason we cannot fix here.
  "exclude": ["**/node_modules", "the-codes/surfaces/mod/tests/engine"]
}