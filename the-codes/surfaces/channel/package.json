{
  "name": "agy-watch-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code channel that pushes agy job state CHANGES into Claude's context.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "agy-watch": "./dist/server.js" },
  "main": "./src/server.ts",
  "scripts": {
