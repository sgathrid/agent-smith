{
  "name": "agent-smith-channel",
  "version": "0.2.0",
  "private": true,
  "description": "Agent Smith MCP server: runs external coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/stamp-entrypoint.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-tasks": "^0.2.2",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
